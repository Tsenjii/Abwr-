{
  "manifest_version": 2,
  "name": "AI Browser Local Bridge",
  "version": "0.11.0",
  "description": "Local-only browser automation messaging",
  "browser_specific_settings": { "gecko": { "id": "agentbridge@local.browser" } },
  "permissions": ["<all_urls>", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }]
}
